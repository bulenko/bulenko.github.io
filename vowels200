<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Тренажёр: Безударные гласные</title>
    <style>
        :root { --primary: #4a90e2; --success: #2ecc71; --error: #e74c3c; --dark: #2c3e50; --light: #f8f9fa; }
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: sans-serif; }
        body { background: #eef2f7; color: var(--dark); padding: 10px; display: flex; justify-content: center; align-items: center; min-height: 100vh; }
        .quiz-container { background: white; width: 100%; max-width: 450px; border-radius: 16px; padding: 20px; box-shadow: 0 10px 25px rgba(0,0,0,0.05); }
        h1 { font-size: 1.15rem; text-align: center; margin-bottom: 15px; color: var(--primary); }
        .progress-bar { width: 100%; height: 6px; background: #e0e0e0; border-radius: 3px; overflow: hidden; margin-bottom: 15px; }
        .progress-fill { height: 100%; background: var(--primary); width: 0%; transition: width 0.2s; }
        .stats { display: flex; justify-content: space-between; font-size: 0.85rem; margin-bottom: 15px; color: #7f8c8d; }
        .word-box { background: var(--light); border: 2px dashed #bdc3c7; border-radius: 12px; padding: 25px 5px; text-align: center; font-size: 1.8rem; font-weight: bold; letter-spacing: 1px; margin-bottom: 20px; }
        .options { display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; margin-bottom: 20px; }
        .btn-opt { background: white; border: 2px solid #dcdde1; border-radius: 8px; padding: 12px 0; font-size: 1.1rem; font-weight: bold; cursor: pointer; color: var(--dark); -webkit-tap-highlight-color: transparent; }
        .btn-opt.correct { background: var(--success); border-color: var(--success); color: white; }
        .btn-opt.wrong { background: var(--error); border-color: var(--error); color: white; }
        .feedback { min-height: 50px; text-align: center; font-size: 0.95rem; margin-bottom: 15px; line-height: 1.3; }
        .feedback.win { color: var(--success); } .feedback.lose { color: var(--error); }
        .btn-next { width: 100%; background: var(--primary); color: white; border: none; border-radius: 8px; padding: 12px; font-size: 1rem; font-weight: bold; cursor: pointer; display: none; }
        .result-screen { text-align: center; display: none; }
        .score-text { font-size: 2.5rem; font-weight: bold; color: var(--primary); margin-top: 10px; margin-bottom: 15px; }
        .btn-restart { background: var(--dark); color: white; border: none; border-radius: 8px; padding: 12px 24px; font-weight: bold; cursor: pointer; }
    </style>
</head>
<body>
<div class="quiz-container">
    <div id="quiz-game">
        <h1 id="quiz-title">Безударные гласные в корне (1-3 класс)</h1>
        <div class="progress-bar"><div class="progress-fill" id="progress"></div></div>
        <div class="stats"><span id="counter">Вопрос: 1/200</span><span id="score-counter">Счёт: 0</span></div>
        <div class="word-box" id="word-display">..</div>
        <div class="options">
            <button class="btn-opt" onclick="check('а')">А</button>
            <button class="btn-opt" onclick="check('о')">О</button>
            <button class="btn-opt" onclick="check('е')">Е</button>
            <button class="btn-opt" onclick="check('и')">И</button>
            <button class="btn-opt" onclick="check('я')">Я</button>
        </div>
        <div class="feedback" id="feedback-display"></div>
        <button class="btn-next" id="btn-next" onclick="nextQ()">Следующее слово</button>
    </div>
    <div class="result-screen" id="result-screen">
        <h2>Тест завершён!</h2>
        <div class="score-text" id="final-score">0 / 200</div>
        <p style="color: #7f8c8d; margin-bottom: 20px;" id="comment"></p>
        <button class="btn-restart" onclick="restart()">Пройти снова</button>
    </div>
</div>
<script>
const raw = {
'а':"Валы(вал) Вода(водный) Глаза(глаз) Грачи(грач) Дарить(дар) Дворы(двор) Дома(дом) Дожди(дождь) Дрожать(дрожь) Жара(жар) Звонить(звон) Катить(катит) Коза(козы) Коса(косы) Коты(кот) Края(край) Кроты(крот) Мала(маленький) Моря(море) Мосты(мост) Ножи(нож) Нора(норы) Носатый(нос) Ночной(ночь) Окно(окна) Платить(платит) Поля(поле) Рога(рог) Роса(росы) Сады(сад) Свеча(свечи) Слоны(слон) Слова(слово) Сова(совы) Сосна(сосны) Столы(стол) Трава(травы) Ходить(ходит) Холмы(холм) Шаги(шаг)",
'о':"Болеть(боль) Борода(бороду) Борьба(борется) Возить(возит) Волна(волны) Ворона(ворон) Гора(горы) Города(город) Гроза(горы) Дорога(дорог) Доска(доски) Дрова(дровник) Зерно(зёрна) Зима(зимы) Золотой(золото) Колени(колено) Колокольчик(колокол) Кольцо(кольца) Кормить(корм) Корове(коров) Кора(корка) Корма(кормчий) Ловить(ловит) Лошадка(лошадь) Молодёжь(молодо) Молчать(молча) Мороз(мороз) Носить(носит) Овца(овцы) Огонь(огненный) Озеро(озера) Поздравлять(поздний) Полоса(полосы) Просить(просит) Родной(родина) Смотреть(смотрит) Снега(снег) Солить(соль) Сторожить(сторож) Точить(точит)",
'е':"Бегун(бег) Беда(беды) Белеть(белый) Ведро(вёдра) Везти(вёз) Веселье(весело) Весна(вёсны) Ветер(ветры) Вечерний(вечер) Взглянуть(взгляд) Гнездо(гнёзда) Грибы(гриб) Дела(дело) Держать(держит) Делить(делит) Деревья(дерево) Ежи(ёж) Звезда(взвёзды) Звериный(зверь) Зеленеть(зелень) Земля(земли) Зеркальный(зеркало) Змея(змеи) Ледник(лёд) Ленивый(лень) Леса(лес) Лиса(лисы) Медовый(мёд) Места(место) Небеса(небо) Нести(нёс) Оперение(перья) Перо(перья) Песчаный(песок) Плечо(плечи) Плести(плёл) Река(реки) Светлячок(свет) Сестра(сёстры) Снегирь(снег)",
'и':"Блины(блин) Винты(винт) Вишнёвый(вишня) Глубокий(глубь) Дикарь(дикий) Живой(жить) Зима(зимы) Игрушка(игры) Китёнок(кит) Крикливый(крик) Линейка(линия) Листы(лист) Лицо(лица) Малыш(маленький) Мирить(мир) Мясной(мясо) Низина(низ) Ниточка(нить) Писатель(пишет) Пищать(писк) Питание(пища) Питьё(пьёт) Плита(плиты) Птенцы(птенчик) Свистеть(вист) Сидеть(сидя) Синеть(синий) Скрипеть(скрип) Слива(сливы) Снежинка(снег) Спина(спины) Стрижи(стриж) Тишина(тихий) Тяжёлый(тяжесть) Хитрец(хитрый) Цвести(цвет) Чижи(чиж) Чистый(чистить) Широкий(ширь) Щипать(щиплет)",
'я':"Вязать(вяжет) Глядеть(взгляд) Грязища(gрязь) Клясться(клятва) Косяк(косо) Лебяжий(лебедь) Летать(полёт) Маяк(маяться) Мячи(мяч) Объяснять(ясно) Плясать(пляска) Пятак(пять) Пятно(пятна) Ряды(ряд) Рябина(рябь) Связист(связь) Слепой(слеп) Смягчить(мягкий) Степной(степь) Стрела(стрелы) Стряпня(стряпать) Текстильный(текст) Тянуть(тянет) Увязать(увяз) Хлеба(хлеб) Шалун(шалость) Щавель(щавелевый) Явиться(явка) Ягодичный(ягода) Ядро(ядра) Языковой(язык) Яичница(яйца) Якоря(якорь) Январский(январь) Янтарный(янтарь) Яростно(ярость) Ясельный(ясли) Яснеть(ясно) Ястребиный(ястреб) Ящерица(ящер)"
};

let list = [], idx = 0, score = 0, done = false;

function init() {
    list = []; idx = 0; score = 0;
    for (let L in raw) {
        raw[L].split(" ").forEach(item => {
            if(!item) return;
            let p = item.replace(")","").split("(");
            let reg = new RegExp(L, "i");
            list.push({ w: p[0], b: p[0].replace(reg, ".."), c: L, t: p[1] });
        });
    }
    list.sort(() => Math.random() - 0.5);
}

function show() {
    done = false;
    document.getElementById("btn-next").style.display = "none";
    document.getElementById("feedback-display").innerHTML = "";
    document.querySelectorAll(".btn-opt").forEach(b => b.className = "btn-opt");
    
    let q = list[idx];
    document.getElementById("word-display").innerText = q.b;
    document.getElementById("counter").innerText = `Вопрос: ${idx + 1}/${list.length}`;
    document.getElementById("score-counter").innerText = `Счёт: ${score}`;
    document.getElementById("progress").style.width = (idx / list.length) * 100 + "%";
}

function check(L) {
    if(done) return; done = true;
    let q = list[idx];
    let win = (L === q.c);
    if(win) score++;
    
    document.querySelectorAll(".btn-opt").forEach(b => {
        if(b.innerText.toLowerCase() === q.c) b.classList.add("correct");
        if(!win && b.innerText.toLowerCase() === L) b.classList.add("wrong");
    });

    let f = document.getElementById("feedback-display");
    if(win) {
        f.innerHTML = `✨ Верно! <strong>${q.w}</strong> (проверочное: <strong>${q.t}</strong>)`;
        f.className = "feedback win";
    } else {
        f.innerHTML = `❌ Ошибка! Правильно: <strong>${q.w}</strong> (проверочное: <strong>${q.t}</strong>)`;
        f.className = "feedback lose";
    }
    document.getElementById("btn-next").style.display = "block";
}

function nextQ() {
    idx++;
    if(idx < list.length) show();
    else {
        document.getElementById("quiz-game").style.display = "none";
        document.getElementById("result-screen").style.display = "block";
        document.getElementById("final-score").innerText = `${score} / ${list.length}`;
        let c = "📚 Попробуйте ещё раз!";
        if(score/list.length >= 0.9) c = "🥇 Отлично! Прекрасный результат!";
        else if(score/list.length >= 0.7) c = "👍 Хорошо, но можно лучше!";
        document.getElementById("comment").innerText = c;
    }
}

function restart() {
    document.getElementById("quiz-game").style.display = "block";
    document.getElementById("result-screen").style.display = "none";
    init(); show();
}

init(); show();
</script>
</body>
</html>
